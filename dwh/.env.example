# Nusxa oling: cp .env.example .env  va parollarni to'ldiring (openssl rand -hex 24).
# Parolda faqat harf va raqam bo'lsin (@ : / kabi belgilar ulanish satrini buzadi).
DWH_DB=dwh
DWH_ADMIN_USER=dwh_admin
DWH_ADMIN_PASSWORD=
DWH_LOADER_PASSWORD=
DWH_READER_PASSWORD=

# Tashqi port va qaysi interfeysda tinglash (faqat lokal uchun 127.0.0.1)
DWH_PORT=5440
DWH_BIND=0.0.0.0

# Xotira sozlamalari: shared_buffers ~ RAM ning 25%, effective_cache_size ~ 50-75%
DWH_SHARED_BUFFERS=1GB
DWH_EFFECTIVE_CACHE_SIZE=3GB
DWH_WORK_MEM=64MB
DWH_MAINTENANCE_WORK_MEM=512MB
