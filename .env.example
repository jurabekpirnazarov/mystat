# ==== docker-compose uchun umumiy sozlamalar ====
# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring

# Tashqi portlar
WEB_PORT=80
DB_PUBLIC_PORT=5433

# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Slash'siz yozing (Django ham, nginx ham shu qiymatdan foydalanadi)
ADMIN_URL=markaz

# ---- PostgreSQL (db konteyneri shu qiymatlar bilan yaratiladi, dump shu bazaga tiklanadi) ----
DB_NAME=consult
DB_USER=consult
DB_PASSWORD=change-me

# ---- Redis ----
USE_REDIS=True

# ---- Email ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@my.stat.uz

# ---- Click (MAJBURIY — bo'lmasa Django ko'tarilmaydi) ----
CLICK_URL=https://my.click.uz/services/pay
MERCHANT_ID=
MERCHANT_SERVICE_ID=
MERCHANT_USER_ID=
CLICK_SECRET_KEY=
RETURN_URL=http://localhost/payment/result

# ---- Saytlar ----
MAIN_URL=http://localhost
SITE_URL=http://localhost
BACKEND_URL=localhost

# ---- Tashqi integratsiyalar ----
REGISTER_BASE_URL=
X_DEVICE_ID=
ONE_ID_CLIENT_ID=
ONE_ID_CLIENT_SECRET=
DIDOX_BASE_URL=https://api.didox.com
DIDOX_PARTNER_TOKEN=
DIDOX_USER_PINFL=
DIDOX_USER_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- Admin 2FA + reCAPTCHA ----
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERSION=v2
RECAPTCHA_SCORE_THRESHOLD=0.5
ADMIN_2FA_ISSUER=my.stat.uz Admin

# ---- Celery Beat jadvali ----
BEAT_DIDOX_CHECK_MINUTES=15
BEAT_REPORT_NOTIFY_HOUR=9
BEAT_REPORT_NOTIFY_MINUTE=0
