# Django Settings
SECRET_KEY=your-super-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Redis Settings
USE_REDIS=True
REDIS_URL=redis://127.0.0.1:6379/1

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Custom Settings
PAGINATION_PAGE_SIZE=20
MAX_UPLOAD_SIZE=5242880

#CLICK Settings
CLICK_URL=click-api
MERCHANT_ID=merchant-id
MERCHANT_SERVICE_ID=merchant-service-id
MERCHANT_USER_ID=merchant-user-id
CLICK_SECRET_KEY=click-secret-key
RETURN_URL=return-url

REGISTER_BASE_URL=register_api
X_DEVICE_ID=device_id

# Admin URL — admin paneli URL prefiksi (default: markaz/)
# Masalan: markaz/, boshqaruv/, cp/, panel/
ADMIN_URL=markaz/

# Admin 2FA + Google reCAPTCHA Settings
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_VERSION=v2
RECAPTCHA_SCORE_THRESHOLD=0.5
ADMIN_2FA_ISSUER=my.stat.uz Admin



# ---- Faqat lokal/dev: seed_demo yaratadigan demo akkauntlar paroli ----
DEMO_USER_PASSWORD=

# GoodSign (DIDOX) stage akkaunti
GOODSIGN_TAX_ID=
GOODSIGN_PASSWORD=
GOODSIGN_COMPANY_ID=
