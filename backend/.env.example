# Django Settings
SECRET_KEY=your-super-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
# Production: bo'sh qolsa CORS hamma uchun ochiq (check --deploy common.W004). Frontend bitta domenda bo'lsa shu domen
CORS_ALLOWED_ORIGINS=
# Login/parol tiklash va murojaat formalari uchun IP bo'yicha chegara (standart 20/min va 30/hour)
# AUTH_THROTTLE_RATE=20/min
# FORM_THROTTLE_RATE=30/hour

# Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Redis Settings
USE_REDIS=True
REDIS_URL=redis://127.0.0.1:6379/1

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Custom Settings
PAGINATION_PAGE_SIZE=20
MAX_UPLOAD_SIZE=5242880

#CLICK Settings
CLICK_URL=click-api
MERCHANT_ID=merchant-id
MERCHANT_SERVICE_ID=merchant-service-id
MERCHANT_USER_ID=merchant-user-id
CLICK_SECRET_KEY=click-secret-key
RETURN_URL=return-url

REGISTER_BASE_URL=register_api
X_DEVICE_ID=device_id

# Admin URL — admin paneli URL prefiksi (default: markaz/)
# Masalan: markaz/, boshqaruv/, cp/, panel/
ADMIN_URL=markaz/

# Admin 2FA + Google reCAPTCHA Settings
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_VERSION=v2
RECAPTCHA_SCORE_THRESHOLD=0.5
ADMIN_2FA_ISSUER=my.stat.uz Admin



# ---- Faqat lokal/dev: seed_demo yaratadigan demo akkauntlar paroli ----
DEMO_USER_PASSWORD=

# GoodSign (DIDOX) stage akkaunti
GOODSIGN_TAX_ID=
GOODSIGN_PASSWORD=
GOODSIGN_COMPANY_ID=

# ---- Lokal LLM (vLLM, OpenAI-mos). Bo'sh qoldirilsa AI qidiruv o'chiq turadi ----
# Server: curl -H "Authorization: Bearer $KEY" http://127.0.0.1:8002/v1/models
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26B-A4B-it
LLM_TIMEOUT=25

# ---- UN Comtrade+ (comtradeplus.un.org). Bepul kalit: Sign in > APIs > Subscribe. Bo'sh bo'lsa faqat ochiq preview (500 qator) ----
COMTRADE_API_KEY=
COMTRADE_PAUSE=1.5
# Kalit bo'lsa har dushanba 03:00 avtomatik yangilanadi (False = o'chirish)
# COMTRADE_SYNC_ENABLED=True
